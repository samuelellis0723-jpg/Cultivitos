# Destino del proxy de Vite durante desarrollo. No poner secretos aquí.
API_PROXY_TARGET=http://127.0.0.1:3000

# Período histórico solicitado: 2015–2024 inclusive, fechas reales YYYYMMDD.
# Historial observado, no pronóstico; reiniciar Vite al cambiar estas variables.
# Build: Vite incorpora estas variables al bundle; cambiarlas solo al iniciar
# Express no lo modifica. Recompilar al cambiar el período.
# Vacío impide consultar historial; no afecta el pronóstico ni el modo demo.
VITE_HISTORY_START=20150101
VITE_HISTORY_END=20241231
